# Databricks Apps deployment configuration for the CSOSA Spending Assistant
# web UI — a second, independent Databricks App from the MCP server
# (deploy/databricks/.env configures that one separately).
#
# Copy to .env and fill in, then:
#   set -a; source deploy/databricks-webapp/.env; set +a
# before running the deploy script.
#
# This file contains NO secrets. Databricks authentication is handled by the
# Databricks CLI (an OAuth login or a DATABRICKS_TOKEN in your environment/CLI
# profile), NOT stored here.

# --- Databricks workspace -----------------------------------------------------
# Your workspace URL. Also settable via the CLI profile; if set here the deploy
# script passes it through.
#   DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_HOST=

# CLI profile to use (from `databricks auth login` / ~/.databrickscfg).
# This MUST match the profile name you chose during `databricks auth login`.
DATABRICKS_CONFIG_PROFILE=DEFAULT

# --- App identity -------------------------------------------------------------
# Name of the Databricks App (created on first deploy); lowercase letters,
# numbers, and hyphens.
APP_NAME=csosa-spending-webapp

# Workspace path where the app source code is uploaded (the deploy script syncs
# the repo here, then deploys from it). Must be an absolute workspace path, and
# different from the MCP server kit's SOURCE_CODE_PATH — each Databricks App
# needs its own synced copy. Replace <you> with your workspace username/email.
SOURCE_CODE_PATH=/Workspace/Users/<you>/csosa-spending-webapp
